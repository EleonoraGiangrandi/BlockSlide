{
  "name": "blockslide",
  "version": "1.0.0",
  "description": "Block Slide - An open-source sliding puzzle game built with React Native and Expo",
  "license": "MIT",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check": "tsc --noEmit",
    "build:apk": "eas build -p android --profile preview",
    "build:bundle": "eas build -p android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "^58.0.24",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-font": "~58.0.11",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
